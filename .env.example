# Research Finder Configuration

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/research_finder.db

# AI Provider (optional - disabled by default)
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_ANALYSES_PER_RUN=10
AI_MAX_ANALYSES_PER_DAY=50

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/research_finder.log

# Discovery
DEFAULT_RADIUS_KM=5
DEFAULT_MIN_RATING=3.0
DEFAULT_MIN_REVIEWS=10
